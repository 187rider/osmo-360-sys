service dji_wireless /usr/bin/dji_wireless_mic
    class main
    user root
    setenv LD_PRELOAD "libdcam_hook.so:libqcom_adapter.so:libdebuggerd_handler_core.so:libdebuggerd_handler_fallback.so"

service console /bin/sh
    class core
    console
    disabled
    user root
    group root
    setenv HOSTNAME oq101
    setenv PS1 "root@oq101:\w # "
    setenv HOME /data

service qmmf-server /usr/bin/qmmf-server
    class main
    user root
    setenv LD_LIBRARY_PATH "/usr/lib/camera/components/:/usr/lib/camera/:/usr/lib/hw"
    setenv XDG_RUNTIME_DIR "/run/user/root/"
    setenv WAYLAND_DISPLAY "wayland-1"
    setenv LD_PRELOAD "libqcom_adapter.so:libdebuggerd_handler_core.so:libdebuggerd_handler_fallback.so"
    onrestart restart dji_camera3

service init_display /etc/initscripts/init_qti_display start
