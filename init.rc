    symlink ../../sde12 /dev/disk/by-partlabel/keymaster_a
    symlink ../../sde13 /dev/disk/by-partlabel/boot_a
    symlink ../../sde14 /dev/disk/by-partlabel/devcfg_a
    symlink ../../sde15 /dev/disk/by-partlabel/qupfw_a
    symlink ../../sde16 /dev/disk/by-partlabel/dtbo_a
