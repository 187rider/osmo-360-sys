service servicemanager /usr/bin/servicemanager
    class main
    user root
    oneshot

service tombstoned /usr/bin/tombstoned
    class main
    user root
    socket tombstoned_crash seqpacket 0666 root root
    socket tombstoned_intercept seqpacket 0666 root root
    socket tombstoned_java_trace seqpacket 0666 root root

service sensorspd /usr/bin/sscrpcd sensorspd
    class main
    user root

service cnss_daemon /usr/sbin/cnss_daemon -n -dd
    class main
    user root
    oneshot

service cnss_daemon_w /usr/sbin/cnss_daemon_w -i pci0 -n -dd
    class main
    user root
    oneshot

service start_ftm /etc/initscripts/ftm.init start
    class main
    user root
    oneshot

service storage-service /usr/bin/storage-service
    class main
    user root
    setenv LD_PRELOAD "libdebuggerd_handler_core.so:libdebuggerd_handler_fallback.so"

service thermal-engine /usr/bin/thermal-engine
    class main
    user root

service time_daemon /usr/bin/time_daemon
    class main
    user root

service zram_setup /sbin/zram-setup start
    class main
    user root
    setenv SWAP_MEMTOTAL_PCT ""
