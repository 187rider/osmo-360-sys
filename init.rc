    class core
    user root

service usb_bulk_raw_05 /bin/sh /usr/bin/usb_bulk_raw_05.sh
    class core
    user root

service setup_usb /bin/sh /bin/setup_usb.sh
    disabled
    oneshot

service ansys_time /usr/bin/python /usr/bin/ansys_boot_time.py all 1
    disabled
    user root

service udevd /sbin/udevd
    class main
    user root

service dji_perload_so /usr/bin/dji_preload_so /usr/bin/preload_so.conf
