    symlink ../../sde21 /dev/disk/by-partlabel/featenabler_a
    symlink ../../sde22 /dev/disk/by-partlabel/qmcs
    symlink ../../sde23 /dev/disk/by-partlabel/qweslicstore_a
    symlink ../../sde24 /dev/disk/by-partlabel/xbl_ramdump_a
    symlink ../../sde25 /dev/disk/by-partlabel/rticmpdata_a
    symlink ../../sde26 /dev/disk/by-partlabel/uefi_b
    symlink ../../sde27 /dev/disk/by-partlabel/aop_b
    symlink ../../sde28 /dev/disk/by-partlabel/aop_config_b
    symlink ../../sde29 /dev/disk/by-partlabel/tz_b
    symlink ../../sde30 /dev/disk/by-partlabel/hyp_b
    symlink ../../sde31 /dev/disk/by-partlabel/modem_b
    symlink ../../sde32 /dev/disk/by-partlabel/bluetooth_b
    symlink ../../sde33 /dev/disk/by-partlabel/bw_secure_b
    symlink ../../sde34 /dev/disk/by-partlabel/mdtp_b
    symlink ../../sde35 /dev/disk/by-partlabel/abl_b
    symlink ../../sde36 /dev/disk/by-partlabel/dsp_b
    symlink ../../sde37 /dev/disk/by-partlabel/keymaster_b
    symlink ../../sde38 /dev/disk/by-partlabel/boot_b
    symlink ../../sde39 /dev/disk/by-partlabel/devcfg_b
    symlink ../../sde40 /dev/disk/by-partlabel/qupfw_b
    symlink ../../sde41 /dev/disk/by-partlabel/dtbo_b
    symlink ../../sde42 /dev/disk/by-partlabel/uefisecapp_b
    symlink ../../sde43 /dev/disk/by-partlabel/imagefv_b
    symlink ../../sde44 /dev/disk/by-partlabel/shrm_b
    symlink ../../sde45 /dev/disk/by-partlabel/cpucp_b
    symlink ../../sde46 /dev/disk/by-partlabel/featenabler_b
    symlink ../../sde47 /dev/disk/by-partlabel/qweslicstore_b
    symlink ../../sde48 /dev/disk/by-partlabel/xbl_ramdump_b
    symlink ../../sde49 /dev/disk/by-partlabel/rticmpdata_b
    symlink ../../sde50 /dev/disk/by-partlabel/devinfo
    symlink ../../sde51 /dev/disk/by-partlabel/dip
    symlink ../../sde52 /dev/disk/by-partlabel/splash
    symlink ../../sde53 /dev/disk/by-partlabel/limits
    symlink ../../sde54 /dev/disk/by-partlabel/limits-cdsp
    symlink ../../sde55 /dev/disk/by-partlabel/toolsfv
    symlink ../../sde56 /dev/disk/by-partlabel/logfs
    symlink ../../sde57 /dev/disk/by-partlabel/storsec
    symlink ../../sde58 /dev/disk/by-partlabel/uefivarstore
    symlink ../../sde59 /dev/disk/by-partlabel/secdata
    symlink ../../sde60 /dev/disk/by-partlabel/vm-data
    symlink ../../sde61 /dev/disk/by-partlabel/mdcompress
    symlink ../../sde62 /dev/disk/by-partlabel/connsec
    symlink ../../sde63 /dev/disk/by-partlabel/tzsc
    symlink ../../sde64 /dev/disk/by-partlabel/spunvm
    symlink ../../sde65 /dev/disk/by-partlabel/xbl_sc_test_mode
    symlink ../../sde66 /dev/disk/by-partlabel/xbl_sc_logs
    symlink ../../sdf2  /dev/disk/by-partlabel/modemst1
    symlink ../../sdf3  /dev/disk/by-partlabel/modemst2
    symlink ../../sdf4  /dev/disk/by-partlabel/fsg
    symlink ../../sdf5  /dev/disk/by-partlabel/fsc

on late-init
    write /dev/kmsg "<3> [test] this is late-init"

    start udevd
    # many service depend on leprop, so advance it as early as possible
    start leprop
    start persist-prop
    start start_dji_second

    mkdir /dev/shm
    mount tmpfs tmpfs /dev/shm nosuid nodev
    mount tmpfs tmpfs /sys/fs/cgroup rw nosuid nodev noexec
    mount tmpfs tmpfs /tmp rw nosuid nodev
    mount tmpfs tmpfs /var/volatile
    mount tmpfs tmpfs /var/cache
    mount tmpfs tmpfs /var/spool
    mount tmpfs tmpfs /var/lib
    mkdir /tmp/logfs

    # Create cgroup mount points for process groups
    mkdir /sys/fs/cgroup/cpuctl
    mount cgroup none /sys/fs/cgroup/cpuctl nodev noexec nosuid cpu
    # mount -t cgroup -o nodev,noexec,nosuid,cpu none /sys/fs/cgroup/cpuctl

    mount_all_ab /etc/post_fstab

    # mount overlay filesystem
    mkdir /overlay
    mkdir /overlay/data
    mkdir /overlay/etc
    mkdir /overlay/cache
    mkdir /overlay/usr
    mkdir /overlay/usr/share
    mkdir /overlay/.data-work
    mkdir /overlay/.etc-work
    mkdir /overlay/.cache-work
    mkdir /overlay/.usr-share-work
    mount_all /etc/overlay_fstab
    chmod 0755 /etc
    chmod 0755 /data
    chmod 0755 /cache

    # create directory for generating tombstones
    mkdir /data/tombstones
    mkdir /data/anr

    start logd
    start dji_perload_so
    # advanced ktop to detect boot performance problem
    start dji_ktop

    wait /dev/.dji_second 600

    start systemd-related
    start perf-hal-service
    start storage-service
    start irsc_util
    start qrtr_ns
    # change sysctl.conf to init.rc command
    start systemd-sysctl

    start tombstoned

    start servicemanager
    start qmmf-server
    start cam_log_dump
    start dji_camera3

    start late_load_ko
    start touch
    start init_display
    start gui

    # init_audio.service
    start boot_adsp_cdsp
    start start_usb

    start random-seed
    start ab-updater
    start adsprpcd
    start adsprpcd-audio
    start busybox-syslog
    start cdsprpcd
    start data-init
    start dji_sw_uav
    start gstd
    trigger init_minidump
    start irqbalance
    trigger sscrpcd
    start cnss_daemon
    start cnss_daemon_w
    start start_ftm
    start thermal-engine
    start time_daemon
    start zram_setup
    start dji_wireless

    trigger init_usb_and_adbd
    start coredump_mon
    start dji_blackbox
    start date_to_kmsg
    start save_system_log
    start dji_bluetooth
    start dji_charger
    start dji_config
    start dji_ftpd
    start dji_gimbal
    start dji_hms
    start dji_http_server
    start dji_kmsg
    start dji_media_server
    start dji_upgrade
    start save_gui_log
    start save_update_log
    start dji_system
    start dji_amt
    trigger start_qseecomd
    start QCMAP
    start dji_sec
    start lefbe
    start sfsconfig
    start wlan_init
    start init_mss
    start pdmapper
    start chg-policy
    start dnsmasq
    start dji_network
    trigger start_qwesd
    start rmt_storage
    start stability_tools
    start log_clear
    start pulseaudio
    start dji_asr
    start dji_io_monitor
    start dji_utop
    start line_chart
    start console
    start process_tomb

on property:sys.powerctl=*
    powerctl ${sys.powerctl}

on property:perf_service.start=1
    start init_post_boot

on start_qseecomd
    exec /bin/sleep 4
    start qseecomd

on charger
    mkdir /tmp/charger_dir
    write /tmp/charger "this is charger"
    start console

on init_usb_and_adbd
    wait /dev/.start_usb 600

on init_minidump
    write /sys/kernel/dload/dload_mode mini
    write /sys/kernel/dload/emmc_dload 1
    exec /bin/sh /usr/bin/getminidump.sh

on sscrpcd
    chown system system /data/persist/sensors
    chown system system /sys/power/wake_lock
    chown system system /sys/power/wake_unlock
    chown system system /dev/dma_heap/
    start sensorspd

on start_qwesd
    exec /bin/sh /etc/initscripts/qwes_license_store
    exec /bin/sh /etc/initscripts/create_qwes_ipc
    start qwesd

service boot_adsp_cdsp /bin/sh /usr/bin/boot_dsp.sh
    class main
    oneshot
    user root

service start_usb /bin/sh /usr/bin/start_usb.sh
    setenv adbd_params "0.2 n 10"
    class main
    oneshot
    user root

service adbd /bin/sh /usr/bin/launch_adbd_aosp_init.sh
    class main
    user root

service random-seed /lib/systemd/systemd-random-seed load
    class main
    oneshot
    user root

service usb_bulk_raw_06 /bin/sh /usr/bin/usb_bulk_raw_06.sh
    class core
    user root

service usb_bulk_raw /usr/bin/usb_bulk_raw
    class core
    user root

service usb_bulk_raw_01 /bin/sh /usr/bin/usb_bulk_raw_01.sh
    class core
    user root

