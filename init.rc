service dji_asr /usr/bin/dji_asr
    class main
    user root
    setenv LD_PRELOAD "libdebuggerd_handler_core.so:libdebuggerd_handler_fallback.so"

service init_post_boot /etc/init.post_boot.sh
    class main
    user root
    oneshot

service pulseaudio /bin/sh /usr/bin/pulseaudio.sh
    class main
    user root
    setenv LD_PRELOAD "libdebuggerd_handler_core.so:libdebuggerd_handler_fallback.so"

service dji_io_monitor /usr/bin/io_monitor.sh
    class main
    user root

service dji_ktop /usr/bin/start_dji_ktop.sh
    class main
    user root

service dji_utop /usr/bin/start_dji_utop.sh
    class main
    user root

service logd /sbin/logd
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram 0222 logd logd

service process_tomb /usr/bin/process_tombstones.sh
    class main
    user root
    oneshot