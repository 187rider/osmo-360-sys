on early-init
    # Set init and its forked children's oom_adj.
    write /proc/1/oom_score_adj 0
    # limit the devkmsg to 40Hz, interval is 5s
    write /proc/sys/kernel/devkmsg_ratelimit_burst 200
    # Disable sysrq from keyboard
    write /proc/sys/kernel/sysrq 0
    # Allow up to 32K FDs per process
    setrlimit 7 32768 32768
    # set coredump size to unlimited
    setrlimit 4 -1 -1
    # Set the security context of /adb_keys if present.
    # restorecon /adb_keys
    # Set the security context of /postinstall if present.
    # restorecon /postinstall
    # Mount cgroup mount point for cpu accounting
    # mount cgroup none /acct nodev noexec nosuid cpuacct
    # mkdir /acct/uid
    # root memory control cgroup, used by lmkd
    # mkdir /dev/memcg 0700 root system
    # mount cgroup none /dev/memcg nodev noexec nosuid memory
    # app mem cgroups, used by activity manager, lmkd and zygote
    # mkdir /dev/memcg/apps/ 0755 system system
    # cgroup for system_server and surfaceflinger
    # mkdir /dev/memcg/system 0550 system system

    mkdir /run
    mount tmpfs tmpfs /run

    write /dev/kmsg "<3> [test] this is early-init"
    start start_dji_system

    # mount debugfs
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

    write /proc/sys/net/unix/max_dgram_qlen 600

    # Mount binderfs
    mkdir /dev/binderfs
    mount binder binder /dev/binderfs
    chmod 0755 /dev/binderfs

    symlink /dev/binderfs/binder /dev/binder
    symlink /dev/binderfs/hwbinder /dev/hwbinder
    symlink /dev/binderfs/vndbinder /dev/vndbinder

    chmod 0666 /dev/binderfs/hwbinder
    chmod 0666 /dev/binderfs/binder
    chmod 0666 /dev/binderfs/vndbinder

    # basic network init
    ifup lo
    hostname localhost
    domainname localdomain

    wait /dev/.dji_system 600

    write /dev/.coldboot_done "0"
    write /dev/kmsg "<3> [test] end start_dji_system"

on init
    write /dev/kmsg "<3> [test] this is init"

    write /dev/kmsg "<3> [test] start mount_all"
    mount_all_ab /etc/pre_fstab
    write /dev/kmsg "<3> [test] end mount_all"
    start chroot_prepare
    wait /dev/.chroot_prepare_done 600
    # chroot to /system_a/ or /system_b/ is done inside chroot command
    chroot
    write /dev/kmsg "<3> chroot finished!"

    # Linux's execveat() syscall may construct paths containing /dev/fd
    # expecting it to point to /proc/self/fd
    symlink /proc/self/fd /dev/fd

    chmod 0755 /run
    chmod 0755 /run/udev
    mkdir /dev/disk/
    mkdir /dev/disk/by-partlabel/
    symlink ../../sda1  /dev/disk/by-partlabel/ssd
    symlink ../../sda2  /dev/disk/by-partlabel/persist
    symlink ../../sda3  /dev/disk/by-partlabel/misc
    symlink ../../sda4  /dev/disk/by-partlabel/keystore
    symlink ../../sda5  /dev/disk/by-partlabel/frp
    symlink ../../sda6  /dev/disk/by-partlabel/art
    symlink ../../sda7  /dev/disk/by-partlabel/system_a
    symlink ../../sda8  /dev/disk/by-partlabel/system_b
    symlink ../../sda9  /dev/disk/by-partlabel/factory_data
    symlink ../../sda10 /dev/disk/by-partlabel/cali
    symlink ../../sda11 /dev/disk/by-partlabel/blackbox
    symlink ../../sda12 /dev/disk/by-partlabel/emulated
    symlink ../../sda13 /dev/disk/by-partlabel/userdata
    symlink ../../sda14 /dev/disk/by-partlabel/rawdump
    symlink ../../sdb1  /dev/disk/by-partlabel/xbl_a
    symlink ../../sdb2  /dev/disk/by-partlabel/xbl_config_a
    symlink ../../sdb3  /dev/disk/by-partlabel/multiimgqti_a
    symlink ../../sdb4  /dev/disk/by-partlabel/multiimgoem_a
    symlink ../../sdb5  /dev/disk/by-partlabel/apdp
    symlink ../../sdc1  /dev/disk/by-partlabel/xbl_b
    symlink ../../sdc2  /dev/disk/by-partlabel/xbl_config_b
    symlink ../../sdc3  /dev/disk/by-partlabel/multiimgqti_b
    symlink ../../sdc4  /dev/disk/by-partlabel/multiimgoem_b
    symlink ../../sdc5  /dev/disk/by-partlabel/apdpb
