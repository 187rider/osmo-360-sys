# DESCRIPTION: BULK

echo "Switching to composition number 0x8008 bulk"  > /dev/kmsg
LOCK_FILE="/tmp/usb_bind_in_progress"
RETRY_CNT=5
INTERVAL=0.5
WAIT_DRIVER_STABLE=0.5

if [ "$1" = "y" ]; then
	num="1"
else
	num="0"
fi

if [ "$#" -ge 2 ]; then
	delay=$2
else
	delay="0"
fi

if [ "$#" -ge 3 ]; then
	from_adb=$3
else
	from_adb="n"
fi

white_card=$(getprop persist.whiteboxdebug)
if [ $white_card -eq 0 ]; then
	white_card="n"
else
	white_card="y"
fi

if [ "$#" -ge 4 ]; then
	wait_udc_time=$4
	# [DJI MODIFIED_BY_DJI_START] ENH: prevent 8008 preempted by other composition when waiting udc
	wait_udc_time=$((wait_udc_time*5))
	# [DJI MODIFIED_BY_DJI_END] ENH: prevent 8008 preempted by other composition when waiting udc
	echo "wait udc time $wait_udc_time"  > /dev/kmsg
else
	wait_udc_time=2
fi

if [ -f /sys/class/android_usb/android$num/enable ]; then
	configfs_supported="n"
else
	configfs_supported="y"
fi

run_non_configfs() {
	if [ $from_adb = "n" ]
	then
		pkill adbd
	fi
	echo 0 > /sys/class/android_usb/android$num/enable
	echo 901D > /sys/class/android_usb/android$num/idProduct
	echo 05C6 > /sys/class/android_usb/android$num/idVendor
	echo diag > /sys/class/android_usb/android0/f_diag/clients
	echo diag,adb > /sys/class/android_usb/android$num/functions
	echo 1 > /sys/class/android_usb/android$num/remote_wakeup
	sleep $delay
	echo 1 > /sys/class/android_usb/android$num/enable
	if [ $from_adb = "n" ]
	then
		/sbin/launch_adbd start
	fi
}

run_configfs() {
	try_cnt=1
	while [ $try_cnt -le $RETRY_CNT ]; do
		if [ -f "$LOCK_FILE" ]; then
			echo "usb composition switching" > /dev/kmsg
			sleep $INTERVAL
		else
			break
		fi
		try_cnt=$((try_cnt + 1))
	done

	if [ $try_cnt -eq $RETRY_CNT ]; then
		echo "usb composition 8008 set failed" > /dev/kmsg
		exit 1
	fi

	# [DJI MODIFIED_BY_DJI_START] ENH: standardize shell script conditional judgment
	if [ "$(cat /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409/configuration)" = "BULK" ]; then
	# [DJI MODIFIED_BY_DJI_END] ENH: standardize shell script conditional judgment
		echo "USB composition already 8008, skip" > /dev/kmsg
		exit 0
	# [DJI MODIFIED_BY_DJI_START] ENH: standardize shell script conditional judgment
	else
		echo "USB composition fail to get configuration BULK" > /dev/kmsg
		# [DJI MODIFIED_BY_DJI_END] ENH: standardize shell script conditional judgment
	fi

	echo start > /tmp/usb_bind_in_progress
	if [ $from_adb = "n" ]
	then
		pkill adbd
		# Give enough time to restart ADBD and open EP0 file node
		sleep 1
	fi
	cd /sys/kernel/config/usb_gadget/g1
	rm os_desc/c* 2> /dev/null
	rm configs/c*/f* 2> /dev/null
	rmdir configs/c.2/strings/* configs/c.3/strings/* 2> /dev/null
	rmdir configs/c.2 configs/c.3 2> /dev/null

	if [ $white_card = "y" ]
	then
		echo 0x2222 > idVendor
		echo "Xtra" > strings/0x409/manufacturer
	else
		echo 0x2ca3 > idVendor
		echo "DJI" > strings/0x409/manufacturer
	fi
	echo 0x0025 > idProduct
	echo 0xEF > bDeviceClass
	echo 0x02 > bDeviceSubClass
	echo 0x01 > bDeviceProtocol
	echo "BULK" > configs/c.1/strings/0x409/configuration
	# [DJI MODIFIED_BY_DJI_START] ENH: Modify ffs's malloc method to static malloc
	echo 65536 > functions/ffs.bulk4/maxpacket
	# [DJI MODIFIED_BY_DJI_END] ENH: Modify ffs's malloc method to static malloc
	ln -s functions/ffs.diag configs/c.1/f1
	ln -s functions/ffs.bulk configs/c.1/f2
	ln -s functions/ffs.bulk1 configs/c.1/f3
	ln -s functions/ffs.bulk5 configs/c.1/f4
	ln -s functions/ffs.bulk4 configs/c.1/f5
	echo 0x80 > configs/c.1/bmAttributes

	echo "binding UDC with Gadget..." $1
	echo $1 > UDC
	if [ $? -eq 0  ]; then
		echo "switch 8008 executed successfully" > /dev/kmsg
	else
		echo "switch 8008 executed fail" > /dev/kmsg
		echo "" > configs/c.1/strings/0x409/configuration
	fi

	cd /
	sleep $WAIT_DRIVER_STABLE
	rm -f /tmp/usb_bind_in_progress
}

target=`source /sbin/usb/target`

if [ $configfs_supported = "y" ]; then
	# [DJI MODIFIED_BY_DJI_START] ENH: prevent 8008 preempted by other composition when waiting udc
	echo start > /tmp/usb_bind_in_progress
	# [DJI MODIFIED_BY_DJI_END] ENH: prevent 8008 preempted by other composition when waiting udc
	i=1
	while [ $i -lt $wait_udc_time ]
	do
		udcname=`ls -1 /sys/class/udc | grep -v dummy_udc | head -n 1`
		if [ -n "$udcname" ]; then
			break
		fi

		# [DJI MODIFIED_BY_DJI_START] ENH: prevent 8008 preempted by other composition when waiting udc
		echo "UDC not found sleep for 0.2 sec\n" > /dev/kmsg
		sleep 0.2
		# [DJI MODIFIED_BY_DJI_END] ENH: prevent 8008 preempted by other composition when waiting udc
		i=$((i+1))
	done

	if [ -z "$udcname" ]; then
		echo "UDC didn't come up, won't be able to connect to adbd" > /dev/kmsg
		rm -f /tmp/usb_bind_in_progress
		exit 1
	fi
	# [DJI MODIFIED_BY_DJI_START] ENH: prevent 8008 preempted by other composition when waiting udc
	rm -f /tmp/usb_bind_in_progress
	# [DJI MODIFIED_BY_DJI_END] ENH: prevent 8008 preempted by other composition when waiting udc
	run_configfs $udcname &
else
	run_non_configfs &
fi

