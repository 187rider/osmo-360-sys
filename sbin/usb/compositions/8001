# DESCRIPTION:  Mass Storage

echo "Switching to composition number 0x8001 : Mass Storage" > /dev/kmsg

if [ "$1" = "y" ]; then
	num="1"
else
	num="0"
fi

if [ "$#" -ge 2 ]; then
	delay=$2
else
	delay="0"
fi

if [ "$#" -ge 3 ]; then
	from_adb=$3
else
	from_adb="n"
fi

if [ -f /sys/class/android_usb/android$num/enable ]; then
	configfs_supported="n"
else
	configfs_supported="y"
fi
run_configfs() {
	echo start > /tmp/usb_bind_in_progress
	if [ $from_adb = "n" ]
	then
		pkill adbd
		# Give enough time to restart ADBD and open EP0 file node
		sleep 1
	fi
	cd /sys/kernel/config/usb_gadget/g1
	rm os_desc/c* 2> /dev/null
	rm configs/c*/f* 2> /dev/null
	rmdir configs/c.2/strings/* configs/c.3/strings/* 2> /dev/null
	rmdir configs/c.2 configs/c.3 2> /dev/null
	echo 0x0506 > idVendor
	echo 0xF000 > idProduct
	echo "MS" > configs/c.1/strings/0x409/configuration
	ln -s functions/mass_storage.0 configs/c.1/f1
	ln -s functions/mass_storage.1 configs/c.1/f2
	#ufs
	echo "/dev/sda9" > /sys/kernel/config/usb_gadget/g1/functions/mass_storage.0/lun.0/file
	#sd card
	echo "/dev/mmcblk1p1" > /sys/kernel/config/usb_gadget/g1/functions/mass_storage.1/lun.0/file
	echo 0xA0 > configs/c.1/bmAttributes
	rm -f /tmp/usb_bind_in_progress
	echo "binding UDC with Gadget..." $1
	echo $1 > UDC
	cd /
}

target=`source /sbin/usb/target`
case $target in
	 *kalama* )
		if [ $configfs_supported = "y" ]; then
			i=1
			while [ $i -lt 60 ]
			do
				udcname=`ls -1 /sys/class/udc | grep -v dummy_udc | head -n 1`
				if [ -n "$udcname" ]; then
					break
				fi
				echo "UDC not found sleep for 1 sec\n"
				sleep 1
				((i=i+1))
			done
			if [ -z "$udcname" ]; then
				echo "UDC didn't come up, won't be able to connect to adbd"
			fi
			echo "0x8001 composition is kalama MS, run_configfs" > /dev/kmsg
		run_configfs $udcname &
		fi
		;;

esac


