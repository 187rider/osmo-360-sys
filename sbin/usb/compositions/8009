# DESCRIPTION: Mass Storage

echo "Switching to composition number 0x8009" > /dev/kmsg
LOCK_FILE="/tmp/usb_bind_in_progress"
RETRY_CNT=3
INTERVAL=0.5
WAIT_DRIVER_STABLE=0.5

if [ "$1" = "y" ]; then
	num="1"
else
	num="0"
fi

if [ "$#" -ge 2 ]; then
	delay=$2
else
	delay="0"
fi

if [ "$#" -ge 3 ]; then
	from_adb=$3
else
	from_adb="n"
fi

if [ -f /sys/class/android_usb/android$num/enable ]; then
	configfs_supported="n"
else
	configfs_supported="y"
fi

run_configfs() {
	try_cnt=1
	while [ $try_cnt -le $RETRY_CNT ]; do
		if [ -f "$LOCK_FILE" ]; then
			echo "usb composition switching" > /dev/kmsg
			sleep $INTERVAL
		else
			break
		fi
		try_cnt=$((try_cnt + 1))
	done

	if [ $try_cnt -eq $RETRY_CNT ]; then
		echo "usb composition 8009 set failed" > /dev/kmsg
		exit 1
	fi

	# [DJI MODIFIED_BY_DJI_START] ENH: standardize shell script conditional judgment
	if [ "$(cat /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409/configuration)" = "MS" ]; then
	# [DJI MODIFIED_BY_DJI_END] ENH: standardize shell script conditional judgment
		echo "USB composition already 0x8009, skip" > /dev/kmsg
		exit 0
	# [DJI MODIFIED_BY_DJI_START] ENH: standardize shell script conditional judgment
	else
		echo "USB composition fail to get configuration MS" > /dev/kmsg
		# [DJI MODIFIED_BY_DJI_END] ENH: standardize shell script conditional judgment
	fi

	echo start > /tmp/usb_bind_in_progress
	if [ $from_adb = "n" ]
	then
		pkill adbd
		# Give enough time to restart ADBD and open EP0 file node
		sleep 1
	fi
	cd /sys/kernel/config/usb_gadget/g1
	rm os_desc/c* 2> /dev/null
	rm configs/c*/f* 2> /dev/null
	rmdir configs/c.2/strings/* configs/c.3/strings/* 2> /dev/null
	rmdir configs/c.2 configs/c.3 2> /dev/null
	# [DJI MODIFIED_BY_DJI_START] ENH: change msc and uvc scene usb vid to 2ca3
	echo 0x2ca3 > idVendor
	# [DJI MODIFIED_BY_DJI_END] ENH: change msc and uvc scene usb vid to 2ca3
	echo 0x8002 > idProduct
	echo "MS" > configs/c.1/strings/0x409/configuration
	ln -s functions/ffs.diag configs/c.1/f1
	ln -s functions/mass_storage.0 configs/c.1/f2

	echo 0xA0 > configs/c.1/bmAttributes

	echo "binding UDC with Gadget..." $1
	echo $1 > UDC
	if [ $? -eq 0  ]; then
		echo "switch 8009 executed successfully" > /dev/kmsg
	else
		echo "switch 8009 executed fail" > /dev/kmsg
		echo "" > configs/c.1/strings/0x409/configuration
	fi
	sleep $WAIT_DRIVER_STABLE
	cd /
	rm -f /tmp/usb_bind_in_progress
}

target=`source /sbin/usb/target`
case $target in
	 *kalama* )
		if [ $configfs_supported = "y" ]; then
			i=1
			while [ $i -lt 2 ]
			do
				udcname=`ls -1 /sys/class/udc | grep -v dummy_udc | head -n 1`
				if [ -n "$udcname" ]; then
					break
				fi
				echo "UDC not found sleep for 1 sec\n"
				sleep 1
				i=$((i+1))
			done
			if [ -z "$udcname" ]; then
				echo "UDC didn't come up, won't be able to connect to adbd" > /dev/kmsg
				exit 1
			fi
			echo "0x8009 composition is kalama ADB_MS, run_configfs" > /dev/kmsg
		run_configfs $udcname &
		fi
		;;

esac

