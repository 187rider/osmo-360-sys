# DESCRIPTION: ADB + UVC

echo "Switching to composition number 0x8004"  > /dev/kmsg
# [DJI MODIFIED_BY_DJI_START] ENH: ensure usb composition switched mutually exclusive
LOCK_FILE="/tmp/usb_bind_in_progress"
RETRY_CNT=3
INTERVAL=0.5
WAIT_DRIVER_STABLE=0.5
# [DJI MODIFIED_BY_DJI_END] ENH: ensure usb composition switched mutually exclusive

if [ "$#" -ge 3 ]; then
	from_adb=$3
else
	from_adb="n"
fi

# [DJI MODIFIED_BY_DJI_START] ENH: change wait adbd ready method by poll ep2
check_ffs_adb_ep() {
	timeout=0
	while :
	do
		sleep 0.2
		if [ -e /dev/usb-ffs/adb/ep2 ]; then
			echo "adb ep2 ready" > /dev/kmsg
			break
		else
			echo "adb ep2 not ready" > /dev/kmsg
		fi

		if [ "$timeout" -ge 10 ]; then
			echo "adb ep2 not ready, please check" > /dev/kmsg
			break
		fi

		timeout=`expr $timeout + 1`
	done
}
# [DJI MODIFIED_BY_DJI_END] ENH: change wait adbd ready method by poll ep2

run_configfs() {
	# [DJI MODIFIED_BY_DJI_START] ENH: ensure usb composition switched mutually exclusive
	try_cnt=1
	while [ $try_cnt -le $RETRY_CNT ]; do
		if [ -f "$LOCK_FILE" ]; then
			echo "usb composition 8004 switching" > /dev/kmsg
			sleep $INTERVAL
		else
			break
		fi
		try_cnt=$((try_cnt + 1))
	done

	if [ $try_cnt -eq $RETRY_CNT ]; then
		echo "usb composition 8004 set failed" > /dev/kmsg
		exit 1
	fi
	# [DJI MODIFIED_BY_DJI_END] ENH: ensure usb composition switched mutually exclusive

	# [DJI MODIFIED_BY_DJI_START] ENH: standardize shell script conditional judgment
	if [ "$(cat /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409/configuration)" = "ADB_UAC2_UVC" ]; then
	# [DJI MODIFIED_BY_DJI_END] ENH: standardize shell script conditional judgment
		echo "USB composition already 0x8004, skip" > /dev/kmsg
		exit 0
	# [DJI MODIFIED_BY_DJI_START] ENH: standardize shell script conditional judgment
	else
		echo "USB composition fail to get configuration ADB_UAC2_UVC" > /dev/kmsg
		# [DJI MODIFIED_BY_DJI_END] ENH: standardize shell script conditional judgment
	fi

	echo start > /tmp/usb_bind_in_progress
	if [ $from_adb = "n" ]
	then
		# [DJI MODIFIED_BY_DJI_START] ENH: replace adbd restart method in aosp_init
		if [ $(cat /proc/cmdline | awk -F 'rdinit=' '{print $2}' | awk -F '/' '{print $NF}') = "aosp_init" ]; then
			echo "adbd restart in aosp_init" > /dev/kmsg
			# [DJI MODIFIED_BY_DJI_START] ENH: change adbd service restart always
			restart adbd
			# [DJI MODIFIED_BY_DJI_END] ENH: change adbd service restart always
		else
			echo "adbd restart in systemd" > /dev/kmsg
			# [DJI MODIFIED_BY_DJI_START] FIX: usb may die when adb run and disconnect
			systemctl restart adbd
			# [DJI MODIFIED_BY_DJI_END] FIX: usb may die when adb run and disconnect
		fi
		# [DJI MODIFIED_BY_DJI_END] ENH: replace adbd restart method in aosp_init
		# [DJI MODIFIED_BY_DJI_START] ENH: change wait adbd ready method by poll ep2
		check_ffs_adb_ep
		# [DJI MODIFIED_BY_DJI_END] ENH: change wait adbd ready method by poll ep2
	fi
	cd /sys/kernel/config/usb_gadget/g1
	rm os_desc/c* 2> /dev/null
	rm configs/c*/f* 2> /dev/null
	rmdir configs/c.2/strings/* configs/c.3/strings/* 2> /dev/null
	rmdir configs/c.2 configs/c.3 2> /dev/null
	# [DJI MODIFIED_BY_DJI_START] ENH: change msc and uvc scene usb vid to 2ca3
	echo 0x2ca3 > idVendor
	# [DJI MODIFIED_BY_DJI_END] ENH: change msc and uvc scene usb vid to 2ca3
	echo 0x8004 > idProduct
	echo 0xEF > bDeviceClass
	echo 0x02 > bDeviceSubClass
	echo 0x01 > bDeviceProtocol
	echo "ADB_UAC2_UVC" > configs/c.1/strings/0x409/configuration
	ln -s functions/ffs.adb configs/c.1/f1
	ln -s functions/uac2.0 configs/c.1/f2
	ln -s functions/uvc.0 configs/c.1/f3
	echo 0x80 > configs/c.1/bmAttributes

	echo "binding UDC with Gadget..." $1
	echo $1 > UDC
	if [ $? -eq 0  ]; then
		echo "switch 8004 executed successfully" > /dev/kmsg
	else
		echo "switch 8004 executed fail" > /dev/kmsg
		echo "" > configs/c.1/strings/0x409/configuration
	fi
	cd /
	# [DJI MODIFIED_BY_DJI_START] ENH: ensure usb composition switched mutually exclusive
	sleep $WAIT_DRIVER_STABLE
	rm -f /tmp/usb_bind_in_progress
	# [DJI MODIFIED_BY_DJI_END] ENH: ensure usb composition switched mutually exclusive
}

case `source /sbin/usb/target` in
	*qcs605* | *qcs610* | *sxr2130* | *kalama* )
		udcname=`ls -1 /sys/class/udc | head -n 1`
		run_configfs $udcname &
		;;
	* )
		echo "This composition is not supported"
		;;
esac

# [TC MODIFIED_BY_DJI_END] change uvc to iso
