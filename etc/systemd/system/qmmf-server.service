[Unit]
Description= QMMF Server Service
SourcePath=/usr/bin/qmmf-server
Requires=servicemanager.service
After=servicemanager.service leprop.service

[Service]
#[DJI MODIFIED_BY_DJI_START] ENH: Root for qmmf-server
User=root
Group=root
#[DJI MODIFIED_BY_DJI_END] ENH: Root for qmmf-server
Restart=always

#[DJI MODIFIED_BY_DJI_START] ENH: Move the configuration to Environment
# EnvironmentFile=/etc/qmmf-server-env
Environment="LD_LIBRARY_PATH=/usr/lib/camera/components/:/usr/lib/camera/:/usr/lib/hw:"
Environment="XDG_RUNTIME_DIR=/run/user/root/"
Environment="WAYLAND_DISPLAY=wayland-1"
#[DJI MODIFIED_BY_DJI_END] ENH: Move the configuration to Environment

ExecStart=/usr/bin/qmmf-server
#[DJI MODIFIED_BY_DJI_START] ENH: bring up dji viewer
Environment="LD_PRELOAD=libqcom_adapter.so"
#[DJI MODIFIED_BY_DJI_END] ENH: bring up dji viewer
[Install]
WantedBy=multi-user.target
