[Unit]
Description=start cnss_daemon_w
SourcePath=/usr/sbin/cnss_daemon_w

[Service]
Restart=no
RemainAfterExit=yes
ExecStart=/usr/sbin/cnss_daemon_w -i pci0 -n -dd
User=wifi
Group=wifi
SupplementaryGroups=kmsg inet
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
