[Unit]
Description= DJI Camera Service
SourcePath=/usr/bin/dji_camera3
Requires=qmmf-server.service
After=qmmf-server.service init_display.service leprop.service cam_log_dump.service

[Service]
Restart=always
Environment="WAYLAND_DISPLAY=wayland-1"
Environment="XDG_RUNTIME_DIR=/run/user/root"
Environment="LD_PRELOAD=libdcam_hook.so:libqcom_adapter.so"
Environment="LD_LIBRARY_PATH=/usr/lib"
Environment="ADSP_LIBRARY_PATH=/system/etc/ML/third_party"
ExecStart=/usr/bin/dji_camera3 -g -u -T
User=root
Group=root

[Install]
WantedBy=multi-user.target
