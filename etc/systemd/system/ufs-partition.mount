[Unit]
Description=Mount custom partition to specified mount point

[Mount]
What=/dev/disk/by-partlabel/factory_data
Where=/factory_data
Type=ext4
Options=rw,discard,data=ordered

[Mount]
What=/dev/disk/by-partlabel/cali
Where=/cali
Type=ext4
Options=rw,discard,data=ordered

[Mount]
What=/dev/disk/by-partlabel/blackbox
Where=/blackbox
Type=ext4
Options=rw,discard,data=ordered

[Mount]
What=/dev/disk/by-partlabel/blackbox_upgrade
Where=/blackbox/upgrade
Type=ext4
Options=rw,discard,data=ordered

[Mount]
What=/dev/disk/by-partlabel/emulated
Where=/mnt/media_rw/emulated
Type=ext4
Options=rw

[Install]
WantedBy=multi-user.target
