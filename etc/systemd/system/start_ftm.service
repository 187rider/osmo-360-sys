[Unit]
Description=start ftm
SourcePath=/etc/initscripts/ftm.init

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/initscripts/ftm.init start
ExecStop=/etc/initscripts/ftm.init stop

[Install]
WantedBy=multi-user.target
