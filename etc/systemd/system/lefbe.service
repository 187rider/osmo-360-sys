[Unit]
Description=File Based Encryption service FBE
After=qseecomd.service
Requires=qseecomd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c '/sbin/lefbeservice start ext4'
ExecStart=/bin/sh -c 'echo -n \"FBE service started\" > /dev/kmsg'

[Install]
RequiredBy=local-fs.target
