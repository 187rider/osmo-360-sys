# [DJI MODIFIED_BY_DJI_START] wait partition mounted before create dir
wait_for_mount() {
    local mount_point=$1
    local timeout=$2
    local count=0

    while ! mount | grep "$mount_point "; do
        usleep 50000  # 等待50毫秒
        let "count=count+1"
        if [ $count -eq $((timeout*20)) ]; then  # 50毫秒等待一次，所以超时时间需要乘以20
            echo "Timeout: Partition $partition did not mount within $timeout seconds"
            return 1
        fi
    done

    echo "Partition $partition is mounted at $mount_point"
    return 0
}

create_dir() {
    local dir=$1

    if [ ! -e "$dir" ]; then
        # 如果目录不存在，则创建目录
        mkdir -p "$dir"
        chmod o+rwx $dir
        echo "Directory $dir created"
    else
        # 如果目录存在，判断是否是目录
        if [ ! -d "$dir" ]; then
            # 如果不是目录，则删除原有的目录并创建新的目录
            rm -f "$dir"
            mkdir -p "$dir"
            chmod o+rwx $dir
            echo "Directory $dir recreated"
        else
            echo "Directory $dir already exists"
        fi
    fi
}

