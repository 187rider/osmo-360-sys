# [DJI MODIFIED_BY_DJI_START] add product prop
#为某个特定项目配置prop, 你需要在项目配置中将prop.conf文件拷贝到etc目录
setprop_from_product_config() {
    BUILD_PROP_FILE="/etc/prop.conf"

    # 检查build.prop文件是否存在
    if [ ! -f "$BUILD_PROP_FILE" ]; then
        echo "File not found: $BUILD_PROP_FILE"
        return 0
    fi

    # 逐行读取文件
    while IFS= read -r line || [ -n "$line" ]
    do
        # 跳过空行和注释行
        if [ -z "$line" ] || [ "${line#\#}" != "$line" ]; then
            continue
        fi

        # 使用 setprop 设置属性
        key=$(echo "$line" | cut -d'=' -f1)
        value=$(echo "$line" | cut -d'=' -f2-)
        setprop "$key" "$value"
        echo "Set property: $key=$value"
    done < "$BUILD_PROP_FILE"
}
