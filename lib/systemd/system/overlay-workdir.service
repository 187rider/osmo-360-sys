[Unit]
Description=Create workdirs for overlayfs usage
DefaultDependencies=no
After=overlay.mount

[Service]
Type=oneshot
ExecStart=/sbin/create-overlay-workdirs

# [DJI MODIFIED_BY_DJI_START] Mount blackbox,cali,factory_data,emulated partition
ExecStartPre=/bin/sh -c 'overlay-workdir.sh'
# [DJI MODIFIED_BY_DJI_END] Mount blackbox,cali,factory_data,emulated partition

RemainAfterExit=yes

[Install]
WantedBy=local-fs.target
