[Unit]
Description=subsystem-ramdump service

[Service]
User=system
Group=system
Restart=always
#[DJI MODIFIED_BY_DJI_START] add minidump.service and enable minidump
#ExecStartPre=/bin/sh -c 'echo 1 > /sys/module/qcom_ramdump/parameters/enable_dump_collection'
#[DJI MODIFIED_BY_DJI_END] add minidump.service and enable minidump
ExecStart=/usr/bin/subsystem_ramdump

[Install]
WantedBy=multi-user.target
