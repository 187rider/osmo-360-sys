[Unit]
Description=MSM Irqbalancer Daemon
SourcePath=/usr/bin/msm-irqbalance
After=systemd-modules-load.service

[Service]
RemainAfterExit=yes
Restart=on-failure
ExecStart=/usr/bin/msm-irqbalance -f /etc/msm_irqbalance.conf

[Install]
WantedBy=multi-user.target
