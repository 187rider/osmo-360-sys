[Unit]
Description=start dsp variants
ConditionVirtualization=!container
Requires=firmware-mount.service
After=firmware-mount.service
StartLimitBurst=10

[Service]
Type=forking
Restart=on-failure
RemainAfterExit=yes
ExecStart= /bin/sh -c " if [ \"$(/bin/ls -A /firmware)\" ]; then /bin/echo 1 > /sys/kernel/boot_cdsp/boot; else /bin/echo \"cdsp: cdsp firmware not found\" > /dev/kmsg; exit 1; fi "

[Install]
WantedBy=multi-user.target
