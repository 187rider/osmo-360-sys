[Unit]
Description=Utility services for Hibernation

[Service]
User=root
Group=root
ExecStart=/usr/bin/hibernateutility
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=hibernateservice

[Install]
WantedBy=multi-user.target
